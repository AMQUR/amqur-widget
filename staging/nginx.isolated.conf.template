server {
    listen LISTEN_PORT;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Railway / probe health — always public (no employee auth).
    location = /healthz {
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        return 200 'ok\n';
    }

    location = /assistant-widget.iife.js {
        default_type application/javascript;
        add_header Cache-Control "public, max-age=300" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri =404;
    }

    location = /amqur-widget.iife.js {
        default_type application/javascript;
        add_header Cache-Control "public, max-age=300" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files /assistant-widget.iife.js =404;
    }

    location = /embed.js {
        default_type application/javascript;
        add_header Cache-Control "public, max-age=300" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri =404;
    }

    location = /embed-manifest.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri =404;
    }

    location = /version.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri =404;
    }

    location ^~ /assets/fonts/ {
        types {
            font/woff2 woff2;
            text/plain txt;
        }
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=86400" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri =404;
    }

    location ~ ^/assistant-widget\.[a-f0-9]+\.iife\.js$ {
        default_type application/javascript;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files /assistant-widget.iife.js =404;
    }

    # Invite redemption page (isolated-staging images only; absent elsewhere -> 404).
    # It predates the strict policy below and carries its own inline script, so it keeps the
    # original header set. Still behind employee auth.
    location = /canary-redeem.html {
        auth_basic "AUTH_REALM";
        auth_basic_user_file /etc/nginx/amqur-employee.htpasswd;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri =404;
    }

    # Private HTML shell (owner page, its stylesheet and script). Basic auth; the entrypoint
    # writes a locked htpasswd when credentials are not configured (fail closed).
    # CSP_API_ORIGIN is the API origin of this build, read from embed-manifest.json at start.
    # style-src needs 'unsafe-inline' because the widget styles its shadow root with a <style>
    # element; scripts stay strictly same-origin.
    location / {
        auth_basic "AUTH_REALM";
        auth_basic_user_file /etc/nginx/amqur-employee.htpasswd;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src CSP_API_ORIGIN; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" always;
        try_files $uri $uri/ /index.html;
    }
}
