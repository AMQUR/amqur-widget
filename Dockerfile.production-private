# syntax=docker/dockerfile:1
# Private production preview host: the same image shape as Dockerfile.isolated-staging (owner
# preview page behind Basic Auth + public widget assets), pinned at build time to the production
# API and widget origins given as build args. No invite-redemption page, no staging hostname.
#
# Required build args (on Railway: service variables with these names):
#   AMQUR_API_HOST     https origin of the production API      e.g. https://<api-service>.up.railway.app
#   AMQUR_WIDGET_HOST  https origin this image is served from  e.g. https://<widget-service>.up.railway.app
# The build fails when either is unset, not https, a staging host or a *.dialusnow.com host.

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG APP_COMMIT_SHA=unknown
ARG APP_BUILD_TIME=unknown
ARG APP_RELEASE_ID=unknown
ARG APP_RELEASE_VERSION=0.2.0
ENV APP_COMMIT_SHA=$APP_COMMIT_SHA \
  APP_BUILD_TIME=$APP_BUILD_TIME \
  APP_RELEASE_ID=$APP_RELEASE_ID \
  APP_RELEASE_VERSION=$APP_RELEASE_VERSION
ARG AMQUR_API_HOST
ARG AMQUR_WIDGET_HOST
# Hard-coded so the service can never silently build another profile.
ARG AMQUR_WIDGET_BUILD_PROFILE=production-private
RUN test "$AMQUR_WIDGET_BUILD_PROFILE" = "production-private"
RUN test -n "$AMQUR_API_HOST" || { echo "AMQUR_API_HOST build arg is required" >&2; exit 1; }
RUN test -n "$AMQUR_WIDGET_HOST" || { echo "AMQUR_WIDGET_HOST build arg is required" >&2; exit 1; }
RUN for h in "$AMQUR_API_HOST" "$AMQUR_WIDGET_HOST"; do \
      case "$h" in https://*) ;; *) echo "host must be https: $h" >&2; exit 1 ;; esac; \
      case "$h" in *staging*|*dialusnow.com*|*localhost*|*127.0.0.1*) echo "host not allowed for production-private: $h" >&2; exit 1 ;; esac; \
    done \
  && test "$AMQUR_API_HOST" != "$AMQUR_WIDGET_HOST" \
  && npm run build \
  && mkdir -p /out \
  && cp dist/assistant-widget.iife.js /out/assistant-widget.iife.js \
  && mkdir -p /out/assets/fonts && cp -R dist/assets/fonts/. /out/assets/fonts/ \
  && cp dist/assistant-widget.iife.js /out/amqur-widget.iife.js \
  && test -f staging/public/index.isolated.html \
  && node scripts/build-embed-loader.mjs --env production-private --out /out \
       --api-host "$AMQUR_API_HOST" --widget-host "$AMQUR_WIDGET_HOST" \
  && node -e 'const fs=require("fs"); const v={name:"amqur-widget",version:process.env.APP_RELEASE_VERSION||"0.2.0",commitSha:process.env.APP_COMMIT_SHA||"unknown",buildTime:process.env.APP_BUILD_TIME||"unknown",releaseId:process.env.APP_RELEASE_ID||"unknown"}; fs.writeFileSync("/out/version.json", JSON.stringify(v,null,2)+"\n");' \
  && grep -F 'data-amqur-profile="production-private"' /out/index.html \
  && grep -F 'data-amqur-isolated-build=' /out/index.html \
  && grep -F 'data-amqur-status="production-private"' /out/index.html \
  && grep -F 'connections are not switched on yet' /out/index.html \
  && grep -F "data-amqur-api-origin=\"$AMQUR_API_HOST\"" /out/index.html \
  && grep -F "\"apiHost\": \"$AMQUR_API_HOST\"" /out/embed-manifest.json \
  && grep -F "\"widgetHost\": \"$AMQUR_WIDGET_HOST\"" /out/embed-manifest.json \
  && grep -F '"environment": "production-private"' /out/embed-manifest.json \
  && ! grep -F '__AMQUR_' /out/index.html \
  && test -f /out/owner-page.css && test -f /out/owner-page.js \
  && test ! -e /out/canary-redeem.html \
  && test ! -e /out/amqur-canary-loader.js \
  && ! grep -Eiq 'staging|sandbox|canary|demonstration data' /out/index.html /out/owner-page.css /out/owner-page.js \
  && ! grep -rEil '[a-z0-9.-]*staging[a-z0-9.-]*\.(up\.railway\.app|dialusnow\.com)' /out \
  && ! grep -rFl -e 'backend-staging-staging-b699.up.railway.app' -e 'widget-staging-staging.up.railway.app' -e 'staging-api.dialusnow.com' -e 'staging-widget.dialusnow.com' /out \
  && ! grep -rFl -e 'https://api.dialusnow.com' -e 'https://widget.dialusnow.com' /out

FROM nginx:alpine
RUN apk add --no-cache openssl
COPY staging/nginx.isolated.conf.template /etc/nginx/templates/default.conf.template
COPY staging/docker-entrypoint-isolated.sh /docker-entrypoint-amqur.sh
COPY --from=build /out/ /usr/share/nginx/html/
RUN chmod +x /docker-entrypoint-amqur.sh \
  && rm -f /etc/nginx/conf.d/default.conf \
  && test -f /usr/share/nginx/html/assistant-widget.iife.js \
  && test -f /usr/share/nginx/html/embed.js \
  && test -f /usr/share/nginx/html/embed-manifest.json \
  && test -f /usr/share/nginx/html/version.json \
  && test -f /usr/share/nginx/html/owner-page.css \
  && test -f /usr/share/nginx/html/owner-page.js \
  && test ! -e /usr/share/nginx/html/canary-redeem.html \
  && grep -F 'data-amqur-profile="production-private"' /usr/share/nginx/html/index.html \
  && ! grep -rFl -e 'backend-staging-staging-b699.up.railway.app' -e 'widget-staging-staging.up.railway.app' -e 'staging-api.dialusnow.com' -e 'staging-widget.dialusnow.com' /usr/share/nginx/html
EXPOSE 80
CMD ["/docker-entrypoint-amqur.sh"]
