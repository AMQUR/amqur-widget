# syntax=docker/dockerfile:1
# Staging canary host — labeled employee testing only (never customer traffic).

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG APP_COMMIT_SHA=unknown
ARG APP_BUILD_TIME=unknown
ARG APP_RELEASE_ID=unknown
ARG APP_RELEASE_VERSION=0.2.0
RUN npm run build \
  && mkdir -p /out \
  && cp dist/assistant-widget.iife.js /out/assistant-widget.iife.js \
  && cp dist/assistant-widget.iife.js /out/amqur-widget.iife.js \
  && cp staging/public/index.html /out/index.html \
  && cp staging/public/amqur-canary-loader.js /out/amqur-canary-loader.js \
  && cp staging/public/canary-redeem.html /out/canary-redeem.html \
  && printf '%s\n' \
    '{' \
    '  "name": "amqur-widget",' \
    "  \"version\": \"${APP_RELEASE_VERSION}\"," \
    "  \"commitSha\": \"${APP_COMMIT_SHA}\"," \
    "  \"buildTime\": \"${APP_BUILD_TIME}\"," \
    "  \"releaseId\": \"${APP_RELEASE_ID}\"" \
    '}' > /out/version.json \
  && grep -q 'STAGING — NOT FOR CUSTOMERS' /out/index.html \
  && grep -q 'staging-api.dialusnow.com' /out/index.html \
  && ! grep -q 'api.dialusnow.com' /out/index.html \
  && ! grep -q 'backend-staging-staging-b699' /out/index.html

FROM nginx:alpine
COPY staging/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY staging/docker-entrypoint.sh /docker-entrypoint-amqur.sh
COPY --from=build /out/ /usr/share/nginx/html/
RUN chmod +x /docker-entrypoint-amqur.sh \
  && rm -f /etc/nginx/conf.d/default.conf \
  && test -f /usr/share/nginx/html/assistant-widget.iife.js \
  && test -f /usr/share/nginx/html/version.json
EXPOSE 80
CMD ["/docker-entrypoint-amqur.sh"]
